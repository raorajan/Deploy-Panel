# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/deploypanel

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# AWS Configuration (for Lambda - Update with your credentials)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
LAMBDA_FUNCTION_NAME=deployment-post-setup

# EC2 SSH Configuration (for Docker deployment)
EC2_HOST=your-ec2-public-ip
EC2_USERNAME=ubuntu
EC2_SSH_KEY_PATH=/path/to/your/ssh-key.pem

# Optional: Enable mock mode for local testing (no AWS/EC2)
MOCK_MODE=true